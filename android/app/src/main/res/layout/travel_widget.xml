<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/travel_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/travel_widget_refresh"
        android:paddingBottom="12dp"
        android:text="My Travels"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/travel_widget_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@+id/travel_widget_title"
        android:padding="8dp"
        android:text="↻"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/travel_refresh_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/travel_widget_refresh"
        android:layout_alignEnd="@+id/travel_widget_refresh"
        android:text="Tap &amp; open app"
        android:textColor="#999999"
        android:textSize="9sp" />

    <ImageView
        android:id="@+id/travel_map_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/travel_widget_title"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="World travel map"
        android:visibility="visible" />

    <TextView
        android:id="@+id/travel_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No travels yet"
        android:textColor="#999999"
        android:textSize="16sp"
        android:visibility="gone" />

</RelativeLayout>
