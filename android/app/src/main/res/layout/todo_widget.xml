<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/widget_refresh"
        android:paddingBottom="12dp"
        android:text="Todo List"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@+id/widget_title"
        android:padding="8dp"
        android:text="↻"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/todo_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/widget_title"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/row1_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="☐"
                android:textColor="#333333"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/row1_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task 1"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/row2_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="☐"
                android:textColor="#333333"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/row2_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task 2"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/row3_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="☐"
                android:textColor="#333333"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/row3_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task 3"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/row4_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="☐"
                android:textColor="#333333"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/row4_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task 4"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/row5_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="☐"
                android:textColor="#333333"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/row5_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task 5"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="..."
            android:textColor="#999999"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
